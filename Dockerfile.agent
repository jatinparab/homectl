ARG HOMECTL_VERSION=dev
ARG HOMECTL_COMMIT=unknown
ARG HOMECTL_BUILD_DATE=unknown
FROM golang:1.25-alpine AS caddy-builder
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    apk add --no-cache git && \
    go install github.com/caddyserver/xcaddy/cmd/xcaddy@v0.4.5 && \
    /go/bin/xcaddy build v2.11.4 \
      --with github.com/caddy-dns/cloudflare@v0.2.4 \
      --output /usr/local/bin/caddy

FROM golang:1.25-alpine AS builder
ARG TARGETARCH
ARG HOMECTL_VERSION
ARG HOMECTL_COMMIT
ARG HOMECTL_BUILD_DATE
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
  -ldflags="-s -w -X github.com/jatinparab/homectl/buildinfo.Version=${HOMECTL_VERSION} -X github.com/jatinparab/homectl/buildinfo.Commit=${HOMECTL_COMMIT} -X github.com/jatinparab/homectl/buildinfo.BuildDate=${HOMECTL_BUILD_DATE} -X github.com/jatinparab/homectl/buildinfo.Component=agent" \
  -o /out/agent ./agent/cmd

FROM alpine:3.20
ARG RESTIC_VERSION=0.18.0
ARG TARGETARCH
RUN apk add --no-cache ca-certificates curl bzip2 docker-cli docker-cli-compose skopeo wireguard-tools
COPY --from=caddy-builder /usr/local/bin/caddy /usr/local/bin/caddy
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64|arm64) ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/restic.bz2 "https://github.com/restic/restic/releases/download/v${RESTIC_VERSION}/restic_${RESTIC_VERSION}_linux_${TARGETARCH}.bz2"; \
    bunzip2 /tmp/restic.bz2; \
    install -m 0755 /tmp/restic /usr/local/bin/restic; \
    rm -f /tmp/restic
COPY --from=builder /out/agent /usr/local/bin/agent
VOLUME ["/config", "/app-data"]
ENTRYPOINT ["/usr/local/bin/agent"]
