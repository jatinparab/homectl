FROM node:20-alpine
WORKDIR /app
# Install deps into the image; docker-compose mounts web/ over /app but
# the node_modules named volume preserves these container-built packages.
COPY web/package.json web/package-lock.json* ./
RUN npm install
EXPOSE 5173
# Source is mounted at /app via docker-compose volume.
CMD ["npx", "vite", "--host", "0.0.0.0"]
