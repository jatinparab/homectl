ARG CROWDSEC_VERSION=v1.8.2
ARG HOMECTL_VERSION=dev
ARG HOMECTL_COMMIT=unknown
ARG HOMECTL_BUILD_DATE=unknown
FROM golang:1.27-alpine AS caddy-builder
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    apk add --no-cache git && \
    go install github.com/caddyserver/xcaddy/cmd/xcaddy@v0.4.5 && \
    /go/bin/xcaddy build v2.11.4 \
      --with github.com/hslatman/caddy-crowdsec-bouncer/http@v0.13.1 \
      --output /usr/local/bin/caddy

FROM crowdsecurity/crowdsec:${CROWDSEC_VERSION} AS crowdsec

FROM node:22-alpine AS web
WORKDIR /web
COPY web/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm --loglevel=error ci
COPY web/ ./
RUN npm --loglevel=error run build

FROM golang:1.27-alpine AS builder
ARG HOMECTL_VERSION
ARG HOMECTL_COMMIT
ARG HOMECTL_BUILD_DATE
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download
COPY . .
COPY --from=web /web/dist /src/manager/ui/dist
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build \
  -ldflags="-s -w -X github.com/jatinparab/homectl/buildinfo.Version=${HOMECTL_VERSION} -X github.com/jatinparab/homectl/buildinfo.Commit=${HOMECTL_COMMIT} -X github.com/jatinparab/homectl/buildinfo.BuildDate=${HOMECTL_BUILD_DATE} -X github.com/jatinparab/homectl/buildinfo.Component=manager" \
  -o /out/manager ./manager/cmd

FROM alpine:3.22
RUN apk add --no-cache ca-certificates docker-cli docker-cli-compose openssh-client wireguard-tools
COPY --from=builder /out/manager /usr/local/bin/manager
COPY --from=caddy-builder /usr/local/bin/caddy /usr/local/bin/caddy
COPY --from=crowdsec /usr/local/bin/crowdsec /usr/local/bin/crowdsec
COPY --from=crowdsec /usr/local/bin/cscli /usr/local/bin/cscli
COPY --from=crowdsec /staging/etc/crowdsec /usr/share/homectl/crowdsec/etc
COPY --from=crowdsec /staging/var/lib/crowdsec/data /usr/share/homectl/crowdsec/data
EXPOSE 80 443 51844/udp
VOLUME ["/config"]
ENTRYPOINT ["/usr/local/bin/manager"]
